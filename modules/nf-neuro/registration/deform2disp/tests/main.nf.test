nextflow_process {

    name "Test Process REGISTRATION_DEFORM2DISP"
    script "../main.nf"
    process "REGISTRATION_DEFORM2DISP"
    config "./nextflow.config"

    tag "modules"
    tag "modules_nfneuro"
    tag "registration"
    tag "registration/deform2disp"

    tag "subworkflows"
    tag "subworkflows/load_test_data"

    setup {
        run("LOAD_TEST_DATA", alias: "LOAD_DATA") {
            script "../../../../../subworkflows/nf-neuro/load_test_data/main.nf"
            process {
                """
                input[0] = channel.from( [ "WB-registration.zip" ] )
                input[1] = "test.load-test-data"
                """
            }
        }
    }

    test("registration - deform2disp") {
        when {
            process {
                """
                input[0] = LOAD_DATA.out.test_data_directory.map{
                    test_data_directory -> [
                        [ id:'test' ],
                        file("\${test_data_directory}/mni_152_sym_09c/forward_algo-easyreg_from-t1_to-template_deformation.nii.gz")
                    ]
                }
                """
            }
        }
        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
        when {
            process {
                """
                input[0] = LOAD_DATA.out.test_data_directory.map{
                    test_data_directory -> [
                        [ id:'test' ],
                        file("\${test_data_directory}/mni_152_sym_09c/forward_algo-easyreg_from-t1_to-template_deformation.nii.gz")
                    ]
                }
                """
            }
        }
        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }

    test("registration - deform2disp - stub-run") {
        tag "stub"
        options "-stub-run"

        when {
            process {
                """
                input[0] = LOAD_DATA.out.test_data_directory.map{
                    test_data_directory -> [
                        [ id:'test' ],
                        file("\${test_data_directory}/mni_152_sym_09c/forward_algo-easyreg_from-t1_to-template_deformation.nii.gz")
                    ]
                }
                """
            }
        }
        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out.versions).match() }
            )
        }
    }

}
